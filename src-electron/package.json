{
  "name": "aidterm-electron",
  "version": "0.2.0",
  "private": true,
  "author": {
    "name": "AidTerm",
    "email": "aidterm@users.noreply.github.com"
  },
  "homepage": "https://github.com/AidTerm/AidTerm",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsc && electron dist/main.js",
    "build": "tsc",
    "start": "electron dist/main.js",
    "dist": "npm run build && electron-builder",
    "postinstall": "electron-rebuild"
  },
  "dependencies": {
    "node-forge": "^1.4.0",
    "node-pty": "^1.1.0",
    "openai": "^6.46.0",
    "serialport": "^13.0.0",
    "ssh2": "^1.17.0",
    "ssh2-sftp-client": "^12.1.1",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@types/node": "^26.1.1",
    "@types/node-forge": "^1.3.14",
    "@types/ssh2": "^1.15.5",
    "@types/ssh2-sftp-client": "^9.0.6",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "typescript": "~5.8.3"
  },
  "build": {
    "appId": "com.aidterm.app",
    "productName": "AidTerm",
    "directories": {
      "output": "./out"
    },
    "files": [
      "dist/**/*"
    ],
    "extraResources": [
      {
        "from": "../dist",
        "to": "dist"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "TerminalEmulator",
      "maintainer": "AidTerm <aidterm@users.noreply.github.com>"
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icons/icon.ico"
    }
  }
}
