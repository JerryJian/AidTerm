{
  "name": "aidterm-electron",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsc && electron dist/main.js",
    "build": "tsc",
    "start": "electron dist/main.js",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "node-pty": "^1.0.0",
    "openai": "^4.0.0",
    "ssh2": "^1.16.0",
    "ssh2-sftp-client": "^11.0.0",
    "serialport": "^12.0.0",
    "uuid": "^9.0.0",
    "node-forge": "^1.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ssh2": "^1.15.0",
    "@types/ssh2-sftp-client": "^9.0.0",
    "@types/uuid": "^9.0.0",
    "@types/node-forge": "^1.3.0",
    "electron": "^33.0.0",
    "typescript": "~5.6.2"
  },
  "build": {
    "appId": "com.aidterm.app",
    "productName": "AidTerm",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "../dist/**/*"
    ],
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "TerminalEmulator"
    },
    "mac": {
      "target": ["dmg"]
    },
    "win": {
      "target": ["nsis"],
      "icon": "icons/icon.ico"
    }
  }
}
