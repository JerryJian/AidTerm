{
  "name": "aidterm-electron",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsc && electron dist/main.js",
    "build": "tsc",
    "start": "electron dist/main.js",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "node-pty": "^1.1.0",
    "openai": "^6.46.0",
    "ssh2": "^1.17.0",
    "ssh2-sftp-client": "^12.1.1",
    "serialport": "^13.0.0",
    "uuid": "^14.0.1",
    "node-forge": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/ssh2": "^1.15.5",
    "@types/ssh2-sftp-client": "^9.0.6",
    "@types/node-forge": "^1.3.14",
    "electron": "^43.1.0",
    "typescript": "~5.8.3"
  },
  "build": {
    "appId": "com.aidterm.app",
    "productName": "AidTerm",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "../dist/**/*"
    ],
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "TerminalEmulator"
    },
    "mac": {
      "target": ["dmg"]
    },
    "win": {
      "target": ["nsis"],
      "icon": "icons/icon.ico"
    }
  }
}
